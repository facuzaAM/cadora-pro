# ── App ──────────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=production
APP_NAME=Cadora API

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cadora:your-db-password@db:5432/cadora
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Supabase (Auth + Storage) ────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
STORAGE_BUCKET=cadora-documents

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-secret-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_DETECTION=10/minute
RATE_LIMIT_CAD=5/minute
RATE_LIMIT_DEMO=1/minute
RATE_LIMIT_CONTACT=3/hour

# ── Paddle Billing (opcional, configurar despues del launch) ──
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=
PADDLE_ENVIRONMENT=sandbox

# ── Google OAuth (opcional — dejar vacío para deshabilitar) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI registrada en Google Cloud Console (debe coincidir exactamente).
# Puede apuntar a api.* aunque el frontend esté en app.* porque las cookies
# de auth se comparten con Domain=<dominio padre> (ver _cookie_domain).
GOOGLE_REDIRECT_URI=https://api.cadora.pro/api/v1/auth/google/callback
FRONTEND_URL=https://cadora.pro

# ── Upload ───────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["https://app.cadora.pro"]

# ── Trusted Hosts ───────────────────────────────────────────
TRUSTED_HOSTS=localhost,127.0.0.1,api,nginx,cadora.pro,app.cadora.pro,api.cadora.pro

# ── Logging ──────────────────────────────────────────────────
LOG_FILE=
LOG_LEVEL=INFO

# ── SMTP (email — necesario para password reset) ──────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@cadora.pro
SMTP_PASSWORD=
EMAIL_FROM=hello@cadora.pro
EMAIL_FROM_NAME=Cadora

# ── Sentry (opcional) ────────────────────────────────────────
SENTRY_DSN=

# ── Postgres (solo docker-compose) ───────────────────────────
POSTGRES_DB=cadora
POSTGRES_USER=cadora
POSTGRES_PASSWORD=changeme
