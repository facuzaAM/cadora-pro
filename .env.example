# ── Docker Compose ──────────────────────────────────────────

# ── Postgres ────────────────────────────────────────────────
POSTGRES_DB=cadora
POSTGRES_USER=cadora
POSTGRES_PASSWORD=changeme

# ── Frontend (opcional) ─────────────────────────────────────
GA_ID=
SENTRY_DSN=
SITE_URL=https://cadora.pro

# ── Backup (opcional) ───────────────────────────────────────
# Encriptación de los dumps con GPG (dejar vacío para dumps en claro).
BACKUP_GPG_PASSPHRASE=
# Subida offsite a Supabase Storage (dejar vacío para solo-local).
BACKUP_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
BACKUP_KEEP_DAYS=30
